# ===================================================
# TEMPLATE KONFIGURASI ENVIRONMENT (.env.example)
# Salin file ini menjadi .env lalu sesuaikan isinya
# ===================================================

# Base URL & API Key Backend Perpustakaan
NUXT_PUBLIC_API_BASE_URL=https://domain-anda.com/api
NUXT_PUBLIC_PUSTAKA_API_KEY=your_pustaka_api_key_here
PUSTAKA_API_KEY=your_pustaka_api_key_here

# ===================================================
# KONFIGURASI GEOLOKASI GPS KAMPUS (CONTOH)
# ===================================================
# Latitude Titik Pusat Kampus (Contoh: -6.255432)
NUXT_PUBLIC_CAMPUS_LAT=-6.000000

# Longitude Titik Pusat Kampus (Contoh: 106.90898)
NUXT_PUBLIC_CAMPUS_LNG=106.000000

# Toleransi Radius Kampus dalam Kilometer (Contoh: 0.35 = 350 meter)
NUXT_PUBLIC_CAMPUS_RADIUS_KM=0.35

# BATAS INAKTIVITAS PETUGAS ONLINE (CONTOH)
# Batas inaktivitas petugas (menit) sebelum otomatis OFFLINE (Contoh: 30)
NUXT_PUBLIC_STAFF_INACTIVITY_MINUTES=30

# ===================================================
# KONFIGURASI INTEGRASI KAVITA E-BOOK SERVER
# ===================================================
KAVITA_BASE_URL=http://localhost:5000
KAVITA_API_KEY=your_kavita_api_key_or_token_here
NUXT_PUBLIC_KAVITA_SERVER_URL=http://localhost:5000

